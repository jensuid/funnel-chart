{
  "name": "funnel-chart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FunnelAnalysis — composite funnel overview + conversion trend visualization (React + ECharts)",
  "keywords": [
    "react",
    "echarts",
    "funnel",
    "funnel-chart",
    "conversion",
    "data-visualization",
    "charts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://example.com/your-org/funnel-chart.git"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build:lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint ."
  },
  "main": "./dist/funnel-chart.cjs",
  "module": "./dist/funnel-chart.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/funnel-chart.js",
      "require": "./dist/funnel-chart.cjs"
    },
    "./funnel-chart.css": "./dist/funnel-chart.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "echarts": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "echarts": "^6.0.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
